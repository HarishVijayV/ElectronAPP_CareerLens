# Secrets — never commit real env files
infra/.env
**/.env
!**/.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env*.local

# Electron desktop shell (node_modules is large; dist holds the built installer)
desktop/node_modules/
desktop/dist/

# Data pipeline artifacts (large, regenerable — never commit generated data)
pipeline/data/
pipeline/dbt/target/
pipeline/dbt/dbt_packages/
pipeline/dbt/logs/
pipeline/dbt/profiles.yml

# Spark / Hadoop local state
**/spark-warehouse/
**/metastore_db/
**/derby.log

# Docker / IDE / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
