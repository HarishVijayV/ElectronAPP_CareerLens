# Copy this file to infra/.env and fill in real values. Never commit the real .env.

# ---- Postgres (main app DB) ----
POSTGRES_USER=careerlens
POSTGRES_PASSWORD=change_me
POSTGRES_DB=careerlens
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://careerlens:change_me@postgres:5432/careerlens

# ---- Redis (cache, sessions, rate limiting, Celery broker) ----
REDIS_URL=redis://redis:6379/0

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ---- Auth / JWT ----
# Gateway rate limit, per user per window. 300/min is sized for a BROWSER: one Analytics
# page load is six requests, and the notification bell polls every minute. Lower it and
# ordinary clicking starts returning "Rate limit exceeded".
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60

JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# ---- Google OAuth (login + Gmail read-only sync) ----
# Encrypts Google tokens at rest. Falls back to JWT_SECRET_KEY if unset.
TOKEN_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000

# ---- LLM provider (agent-service) ----
# one of: gemini | fireworks | anthropic | openai
#
# gemini is the default because it's the only one with a genuinely PERMANENT free tier
# (rate-limited, no card required) — the others hand out trial credits and then bill per
# token. Get a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731
# Used only if the model above is retired. Open-weight names outlive proprietary ones.
FIREWORKS_FALLBACK_MODEL=accounts/fireworks/models/gpt-oss-120b
FIREWORKS_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Job board APIs (ingestion) ----
# Remotive + Arbeitnow need NO key. Adzuna is free but needs a signup:
# https://developer.adzuna.com/  — it's the one that covers BOTH India and USA.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---- Snowflake (warehouse, used by pipeline/dbt) ----
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=CAREERLENS
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_SCHEMA=PUBLIC

# ---- Service ports (defaults, change if they collide locally) ----
GATEWAY_PORT=8000
AUTH_SERVICE_PORT=8001
AGENT_SERVICE_PORT=8002
JOBS_SERVICE_PORT=8003
NOTIFICATION_SERVICE_PORT=8004
MCP_SERVER_PORT=8005
FRONTEND_PORT=3000
